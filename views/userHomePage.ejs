<img id = "user" src = "<%= (user.image || '/img/default.jpg') + '?v=' + Date.now() %>" width = "800" height = "500">
<form style=" margin-left: 60px" action="/upload-profile" method="POST" enctype="multipart/form-data">
    <input type="file" class="file-btn" name = "image" accept="image/*" /> <!--image/* means any type : .jpg,.png,.webp etc-->
    <button id = "upload" class="btn">Upload</button>
</form>
<section class="articles">
  <h2 class="articles_heading">Latest Posts</h2>
  <ul class="article-ul">
    <% data.forEach(post => { %>
    <li>
      <a href="/u/post/<%= post._id %>">
        <span><%= post.title %></span>
        <span class="article-list_date"><%= post.createdAt.toDateString() %></span>
      </a>
    </li>
      <% }) %>
  </ul>
  <div class="pagination-container">
    <% if (nextPage!==null) { %>
    <a href="/home/?page=<%= nextPage %>" class="pagination">&lt; View Older Posts</a>
    <% } %>
    <% if (prevPage!==null) { %>
    <a href="/home/?page=<%= prevPage %>" class="pagination">View Newer Posts &gt;</a>
    <% } %>
  </div>
</section>
