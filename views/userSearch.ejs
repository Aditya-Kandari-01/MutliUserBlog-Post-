<div class="author">
    <h1 class="author_heading">Search Results : </h1>
</div>
<section class="articles">
  <a href="/home/<%= userDetails.username %>">&larr; Back</a>
<ul class="article-ul">
    <% if (data && data.length>0) { %>
        <% data.forEach(post => { %>
    <li>
      <a href="/home/<%= userDetails.username %>/<%= post._id %>">
        <span><%= post.title %></span>
        <span class="article-list_date"><%= post.createdAt.toDateString() %></span>
      </a>
    </li>
      <% }) %>
     
    <% } else { %>
     <h2>No Posts</h2s>
    <% } %>

  </ul>
</section>